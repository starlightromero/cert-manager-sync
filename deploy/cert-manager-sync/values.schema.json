{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "title": "affinity",
      "type": "object"
    },
    "autoscaling": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "maxReplicas": {
          "default": 100,
          "title": "maxReplicas",
          "type": "integer"
        },
        "minReplicas": {
          "default": 1,
          "title": "minReplicas",
          "type": "integer"
        },
        "targetCPUUtilizationPercentage": {
          "default": 80,
          "title": "targetCPUUtilizationPercentage",
          "type": "integer"
        },
        "targetMemoryUtilizationPercentage": {
          "title": "targetMemoryUtilizationPercentage",
          "type": "integer"
        }
      },
      "title": "autoscaling",
      "type": "object"
    },
    "clusterRole": {
      "additionalProperties": true,
      "properties": {
        "create": {
          "default": true,
          "title": "create",
          "type": "boolean"
        }
      },
      "title": "clusterRole",
      "type": "object"
    },
    "config": {
      "additionalProperties": true,
      "properties": {
        "disableCache": {
          "default": "false",
          "title": "disableCache",
          "type": "string"
        },
        "disabledNamespaces": {
          "default": "",
          "title": "disabledNamespaces",
          "type": "string"
        },
        "enabledNamespaces": {
          "default": "",
          "title": "enabledNamespaces",
          "type": "string"
        },
        "logFormat": {
          "default": "json",
          "title": "logFormat",
          "type": "string"
        },
        "logLevel": {
          "default": "info",
          "title": "logLevel",
          "type": "string"
        },
        "operatorName": {
          "default": "cert-manager-sync.lestak.sh",
          "title": "operatorName",
          "type": "string"
        },
        "secretsNamespace": {
          "default": "",
          "title": "secretsNamespace",
          "type": "string"
        }
      },
      "title": "config",
      "type": "object"
    },
    "env": {
      "description": "additional env vars to be passed to the container",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "env",
      "type": "array"
    },
    "fullnameOverride": {
      "default": "",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "additionalProperties": true,
      "title": "global",
      "type": "object"
    },
    "image": {
      "additionalProperties": true,
      "properties": {
        "pullPolicy": {
          "default": "IfNotPresent",
          "title": "pullPolicy",
          "type": "string"
        },
        "repository": {
          "default": "robertlestak/cert-manager-sync",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "latest",
          "description": "Overrides the image tag whose default is the chart appVersion.",
          "title": "tag",
          "type": "string"
        }
      },
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "labels": {
      "additionalProperties": true,
      "title": "labels",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "port": {
          "default": 9090,
          "title": "port",
          "type": "integer"
        }
      },
      "title": "metrics",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "title": "nameOverride",
      "type": "string"
    },
    "nodeSelector": {
      "additionalProperties": true,
      "title": "nodeSelector",
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": true,
      "title": "podAnnotations",
      "type": "object"
    },
    "podDisruptionBudget": {
      "additionalProperties": true,
      "description": "Pod Disruption Budget configuration",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable PodDisruptionBudget",
          "title": "enabled",
          "type": "boolean"
        },
        "maxUnavailable": {
          "default": "",
          "description": "Maximum number of pods that can be unavailable (alternative to minAvailable)",
          "title": "maxUnavailable",
          "type": "string"
        },
        "minAvailable": {
          "default": 1,
          "description": "Minimum number of pods that must be available",
          "title": "minAvailable",
          "type": "integer"
        }
      },
      "title": "podDisruptionBudget",
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "title": "podSecurityContext",
      "type": "object"
    },
    "priorityClassName": {
      "default": "",
      "description": "Priority class name for pod scheduling",
      "title": "priorityClassName",
      "type": "string"
    },
    "replicaCount": {
      "default": 1,
      "title": "replicaCount",
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "title": "resources",
      "type": "object"
    },
    "securityContext": {
      "additionalProperties": true,
      "title": "securityContext",
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": true,
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "description": "Annotations to add to the service account",
          "title": "annotations",
          "type": "object"
        },
        "create": {
          "default": true,
          "description": "Specifies whether a service account should be created",
          "title": "create",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "   eks.amazonaws.com/role-arn: arn:aws:iam::ACCOUNT_ID:role/ROLE_NAME\n   iam.gke.io/gcp-service-account: GSA_NAME\nThe name of the service account to use.\nIf not set and create is true, a name is generated using the fullname template",
          "title": "name",
          "type": "string"
        }
      },
      "title": "serviceAccount",
      "type": "object"
    },
    "tolerations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "tolerations",
      "type": "array"
    },
    "topologySpreadConstraints": {
      "description": "Topology spread constraints for pod distribution",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "topologySpreadConstraints",
      "type": "array"
    }
  },
  "type": "object"
}