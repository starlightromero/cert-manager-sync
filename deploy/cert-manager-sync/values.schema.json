{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "cert-manager-sync Helm Chart Values",
  "description": "Schema for validating cert-manager-sync Helm chart values",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of replicas for the deployment"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Image pull policy"
        },
        "tag": {
          "type": "string",
          "description": "Image tag (overrides appVersion)"
        }
      },
      "required": ["repository", "pullPolicy"],
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "description": "Image pull secrets"
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the name of the chart"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name of the chart"
    },
    "config": {
      "type": "object",
      "properties": {
        "operatorName": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$",
          "description": "Operator name used in annotations"
        },
        "secretsNamespace": {
          "type": "string",
          "description": "DEPRECATED: Single namespace to watch"
        },
        "disabledNamespaces": {
          "type": "string",
          "description": "Comma-separated list of namespaces to ignore"
        },
        "enabledNamespaces": {
          "type": "string",
          "description": "Comma-separated list of namespaces to watch"
        },
        "logLevel": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error", "fatal"],
          "description": "Log level"
        },
        "logFormat": {
          "type": "string",
          "enum": ["json", "text"],
          "description": "Log format"
        },
        "disableCache": {
          "type": "string",
          "enum": ["true", "false"],
          "description": "Disable caching mechanism"
        }
      },
      "required": ["operatorName", "logLevel", "logFormat", "disableCache"],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Prometheus metrics"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Metrics server port"
        }
      },
      "required": ["enabled", "port"],
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create service account"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Service account annotations"
        },
        "name": {
          "type": "string",
          "description": "Service account name"
        }
      },
      "required": ["create"],
      "additionalProperties": false
    },
    "clusterRole": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create cluster role and binding"
        }
      },
      "required": ["create"],
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Pod annotations"
    },
    "priorityClassName": {
      "type": "string",
      "description": "Priority class name for pod scheduling"
    },
    "priorityClass": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a PriorityClass resource"
        },
        "name": {
          "type": "string",
          "description": "Name of the PriorityClass"
        },
        "value": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 1000000000,
          "description": "Priority value (higher values have higher priority)"
        },
        "globalDefault": {
          "type": "boolean",
          "description": "Whether this should be the global default priority class"
        },
        "description": {
          "type": "string",
          "description": "Description of the priority class"
        }
      },
      "required": ["create"],
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object",
      "description": "Pod security context"
    },
    "securityContext": {
      "type": "object",
      "description": "Container security context"
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m?$|^[0-9]*\\.?[0-9]+$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$"
            }
          },
          "additionalProperties": false
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m?$|^[0-9]*\\.?[0-9]+$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Resource requests and limits"
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "description": "Additional environment variables"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable horizontal pod autoscaler"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of replicas"
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of replicas"
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Target CPU utilization percentage"
        },
        "targetMemoryUtilizationPercentage": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "string",
              "enum": [""]
            }
          ],
          "description": "Target memory utilization percentage"
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable PodDisruptionBudget"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            }
          ],
          "description": "Minimum number of pods that must be available"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$|^$"
            }
          ],
          "description": "Maximum number of pods that can be unavailable"
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable NetworkPolicy"
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Additional ingress rules"
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Additional egress rules"
        },
        "policyTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Ingress", "Egress"]
          },
          "description": "Policy types to apply"
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": ["Equal", "Exists"]
          },
          "value": {
            "type": "string"
          },
          "effect": {
            "type": "string",
            "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]
          },
          "tolerationSeconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "description": "Tolerations"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "maxSkew": {
            "type": "integer",
            "minimum": 1
          },
          "topologyKey": {
            "type": "string"
          },
          "whenUnsatisfiable": {
            "type": "string",
            "enum": ["DoNotSchedule", "ScheduleAnyway"]
          },
          "labelSelector": {
            "type": "object"
          }
        },
        "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"],
        "additionalProperties": false
      },
      "description": "Topology spread constraints for pod distribution"
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules"
    }
  },
  "required": [
    "replicaCount",
    "image",
    "config",
    "metrics",
    "serviceAccount",
    "clusterRole"
  ],
  "additionalProperties": false
}